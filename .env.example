# ---------- Core ----------
NODE_ENV=development                          # development | production | test
LOG_LEVEL=info                                # pino level: trace|debug|info|warn|error
APP_URL=http://localhost:3000                 # Public URL of the dashboard (links in texts point here)
API_URL=http://localhost:4000                 # Internal URL the web app uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000     # Same as API_URL, exposed to the browser for the dev phone link only
API_PORT=4000                                 # Port the API listens on
AGENT_NAME=Remy                               # The agent's first name, used in texts and the dashboard
AUTONOMY_LEVEL=B                              # B = read/draft/fill, never submit. C = submit on explicit approval (future).

# ---------- Database / queue ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tbd        # Supabase: Project Settings → Database → connection string (session mode)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/tbd_test  # Separate DB used by integration tests (created by pnpm db:ready)
REDIS_URL=redis://localhost:6379              # Upstash: console → database → "Redis connect" URL (rediss://...)

# ---------- Auth ----------
AUTH_MODE=dev                                 # dev = signed-cookie dev login at /dev/login; clerk = Clerk
DEV_AUTH_SECRET=dev-secret-change-me          # HMAC secret for dev-mode session tokens (any long random string)
ADMIN_EMAILS=admin@example.com                # Comma-separated emails that get the admin role on login
CLERK_SECRET_KEY=                             # Clerk dashboard → API Keys → Secret key (AUTH_MODE=clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=            # Clerk dashboard → API Keys → Publishable key (AUTH_MODE=clerk)

# ---------- LLM ----------
LLM_PROVIDER=fake                             # fake = deterministic rule-based model for local dev/tests; anthropic = real
ANTHROPIC_API_KEY=                            # console.anthropic.com → API Keys
LLM_DEFAULT_MODEL=claude-sonnet-5             # Runtime model for conversation, extraction, prioritization phrasing
LLM_STRONG_MODEL=claude-opus-5                # High-stakes reasoning: essay feedback, weekly plan, ambiguous reconciliation

# ---------- Messaging (iMessage) ----------
MESSAGING_PROVIDER=fake                       # fake = /dev/phone simulator; sendblue = real iMessage
SENDBLUE_API_KEY_ID=                          # sendblue.co dashboard → API Keys → Key ID
SENDBLUE_API_SECRET_KEY=                      # sendblue.co dashboard → API Keys → Secret
SENDBLUE_PHONE_NUMBER=                        # The Sendblue number students text, E.164 (+1...)
SENDBLUE_WEBHOOK_SECRET=                      # Random string; configure the same value as the webhook signing secret in Sendblue (sent as `sb-signing-secret` header)

# ---------- Browser / Common App ----------
BROWSER_PROVIDER=local                        # local = Chromium on this machine; browserbase = cloud sessions with replay
BROWSERBASE_API_KEY=                          # browserbase.com → Settings → API Keys
BROWSERBASE_PROJECT_ID=                       # browserbase.com → Settings → Project ID
MOCK_COMMONAPP=true                           # true = point the reader at the local mock Common App site (served by the worker on COMMONAPP_MOCK_PORT)
COMMONAPP_BASE_URL=https://apply.commonapp.org   # Overridden to the mock site automatically when MOCK_COMMONAPP=true
COMMONAPP_MOCK_PORT=4100                      # Port for the mock Common App site
COMMONAPP_MOCK_VERIFICATION_CODE=             # If set, the mock site demands this code after login (exercises pause/resume)
RECORD_FIXTURES=false                         # true = save redacted HTML of every page visited during a real sync to packages/browser/fixtures/recorded
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=           # Optional: path to a Chromium binary for BROWSER_PROVIDER=local (leave empty to use Playwright's bundled browser)
STAGEHAND_FALLBACK=false                      # true = use Stagehand extract() when deterministic extraction confidence is low (needs ANTHROPIC_API_KEY)

# ---------- Credentials at rest ----------
CREDENTIALS_ENCRYPTION_KEYS=1:ZGV2LWtleS1kZXYta2V5LWRldi1rZXktZGV2LWtleS0xMjM=   # "version:base64(32 bytes)" pairs, comma-separated. Generate: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY_VERSION=1          # Which key version new encryptions use (rotate by adding a key and bumping this)

# ---------- Storage ----------
STORAGE_PROVIDER=local                        # local = .data/storage on disk; s3 = S3-compatible (AWS or Supabase Storage S3 endpoint)
STORAGE_LOCAL_DIR=.data/storage               # Directory for local storage
S3_ENDPOINT=                                  # Supabase: Project Settings → Storage → S3 endpoint (https://<ref>.supabase.co/storage/v1/s3)
S3_REGION=us-east-1                           # Supabase uses the project region; AWS uses the bucket region
S3_BUCKET=                                    # Bucket name (create it private)
S3_ACCESS_KEY_ID=                             # Supabase: Storage → S3 access keys; AWS: IAM
S3_SECRET_ACCESS_KEY=                         # Same place as above

# ---------- Gmail (optional, feature-flagged) ----------
FEATURE_GMAIL=false                           # true enables the read-only Gmail connect flow
GOOGLE_CLIENT_ID=                             # Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
GOOGLE_CLIENT_SECRET=                         # Same OAuth client
GOOGLE_REDIRECT_URI=http://localhost:4000/oauth/google/callback   # Must match the OAuth client's authorized redirect URI
