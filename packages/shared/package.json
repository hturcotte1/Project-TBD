{
  "name": "@tbd/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema.ts",
    "./schemas": "./src/schemas/index.ts",
    "./api": "./src/api/index.ts",
    "./adapters": "./src/adapters/index.ts",
    "./jobs": "./src/jobs/index.ts",
    "./config": "./src/config/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./logging": "./src/logging/index.ts",
    "./time": "./src/time/index.ts",
    "./requirements": "./src/requirements/index.ts",
    "./prioritize": "./src/prioritize/index.ts",
    "./proactive": "./src/proactive/index.ts",
    "./seed": "./src/seed/index.ts",
    "./testing": "./src/testing/index.ts",
    "./auth": "./src/auth/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed/run.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:ready": "tsx src/db/ready.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bullmq": "^5.81.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.0",
    "ioredis": "^5.11.0",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.0",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
