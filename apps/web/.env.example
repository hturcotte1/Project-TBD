# Copy to .env.local for local development.

AUTH_MODE=dev                                 # dev = signed-cookie dev login at /dev/login; clerk = Clerk
DEV_AUTH_SECRET=dev-secret-change-me          # Must match the API's DEV_AUTH_SECRET (HMAC secret for dev tokens)
API_URL=http://localhost:4000                 # Internal URL this app uses to reach apps/api (server components, /api/proxy)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=            # Clerk dashboard → API Keys → Publishable key (AUTH_MODE=clerk only)
CLERK_SECRET_KEY=                             # Clerk dashboard → API Keys → Secret key (AUTH_MODE=clerk only)
